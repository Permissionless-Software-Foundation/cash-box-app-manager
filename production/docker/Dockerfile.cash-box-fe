# cash-box-fe UI: clone from GitHub, build with Vite, serve with nginx (no local app source)
ARG CASH_BOX_FE_REPO=https://github.com/Permissionless-Software-Foundation/cash-box-fe.git
# Omit to use the repository default branch; set e.g. master or main if you need a fixed ref
ARG CASH_BOX_FE_REF=

FROM node:20-bookworm-slim AS builder
ARG CASH_BOX_FE_REPO
ARG CASH_BOX_FE_REF
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN if [ -n "$CASH_BOX_FE_REF" ]; then \
      git clone --depth 1 --branch "$CASH_BOX_FE_REF" "$CASH_BOX_FE_REPO" .; \
    else \
      git clone --depth 1 "$CASH_BOX_FE_REPO" .; \
    fi

# Upstream lockfile may lag package.json; install from manifest so the image tracks the repo default branch.
RUN npm install && npm run build

FROM nginx:1.27-alpine
COPY nginx.cash-box-fe.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /src/dist /usr/share/nginx/html
EXPOSE 80
