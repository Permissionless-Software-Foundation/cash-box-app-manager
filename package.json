  "author": "",
  "license": "MIT",
  "dependencies": {
    "apidoc": "1.2.0",
    "cors": "2.8.5",
    "dotenv": "16.3.1",
    "express": "4.18.2",
    "level": "10.0.0",
    "winston": "3.11.0",
    "winston-daily-rotate-file": "4.7.1"
  },
  "devDependencies": {
    "c8": "10.1.3",
    "chai": "4.3.10",
    "mocha": "10.2.0",
    "sinon": "17.0.1",
    "standard": "17.1.2"
  }
}
